{
  "name": "pdfmaster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PDFmaster — a professional, fully client-side PDF editor with an Adobe Acrobat-style workspace. Read, annotate, edit, sign, protect, OCR, organize and convert PDFs without uploading anything.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@signpdf/placeholder-plain": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "buffer": "^6.0.3",
    "clsx": "2.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "idb-keyval": "6.2.2",
    "jszip": "3.10.1",
    "lucide-react": "0.545.0",
    "node-forge": "1.4.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.3.1",
    "tesseract.js": "7.0.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/node": "22.18.10",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "7.1.10",
    "vite-plugin-pwa": "1.0.3",
    "vite-plugin-static-copy": "3.1.2",
    "vitest": "3.2.4"
  }
}
