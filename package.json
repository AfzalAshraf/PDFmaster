{
  "name": "pdfmaster",
  "version": "1.2.0",
  "author": "PDFmaster contributors",
  "private": true,
  "type": "module",
  "description": "PDFmaster — a local-first PDF editor for browser and Windows desktop. Read, annotate, edit, sign, protect, OCR, organize and convert PDFs without uploading documents.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --dir --publish never",
    "desktop:win:package": "electron-builder --win nsis portable --x64 --publish never",
    "desktop:win": "npm run build && npm run desktop:win:package"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@signpdf/placeholder-plain": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "buffer": "^6.0.3",
    "clsx": "2.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "idb-keyval": "6.2.2",
    "jszip": "3.10.1",
    "lucide-react": "0.545.0",
    "node-forge": "1.4.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.3.1",
    "tesseract.js": "7.0.0",
    "zustand": "5.0.8",
    "@eslint/js": "9.38.0",
    "@types/node": "22.18.10",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "7.1.10",
    "vite-plugin-pwa": "1.0.3",
    "vite-plugin-static-copy": "3.1.2",
    "vitest": "3.2.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.pdfmaster.desktop",
    "productName": "PDFmaster",
    "asar": true,
    "directories": {
      "output": "desktop-dist",
      "buildResources": "desktop/build"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "icon": "desktop/build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF document",
          "description": "Open PDF documents with PDFmaster",
          "role": "Viewer",
          "icon": "desktop/build/icon.ico"
        }
      ]
    },
    "nsis": {
      "artifactName": "PDFmaster-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDFmaster",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "PDFmaster-Portable.exe"
    }
  }
}
